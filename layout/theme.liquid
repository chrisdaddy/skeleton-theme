<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {%- render 'head-meta' -%}
    {%- render 'tokens' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'bp-core.js' | asset_url }}" type="module" defer="defer"></script>
    {{ content_for_header }}
  </head>
  <body>
    <a class="bp-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% sections 'header-group' %}
    <main id="MainContent" class="bp-main" tabindex="-1" data-template="{{ template.name }}">
      {{ content_for_layout }}
    </main>
    {% sections 'footer-group' %}
  </body>
</html>
