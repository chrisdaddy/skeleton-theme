      "type": "blueprint_faq",
      "handle": "kindling-faq-1",
      "fields": {
        "question": "Does it taste like mushrooms?",
        "answer": {
          "rich": "No. It tastes like a smooth medium roast with a little cinnamon. The mushrooms are extracts, not ground caps."
        }
      }
    },
    {
      "type": "blueprint_faq",
      "handle": "kindling-faq-2",
      "fields": {
        "question": "How much caffeine?",
        "answer": {
          "rich": "50 mg a cup, about half a regular coffee. Enough to feel, not enough to crash."
        }
      }
    },
    {
      "type": "blueprint_faq",
      "handle": "kindling-faq-3",
      "fields": {
        "question": "Can I use it in my machine?",
        "answer": {
          "rich": "Whole bean and ground work in any brewer. Sachets dissolve in hot water or milk."
        }
      }
    },
