      "handle": "allele-faq-1",
      "fields": {
        "question": "Retinal vs retinol?",
        "answer": {
          "rich": "Retinal (retinaldehyde) is one conversion step from retinoic acid; retinol is two. Faster results, similar tolerance when encapsulated."
        }
