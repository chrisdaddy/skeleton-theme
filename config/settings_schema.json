  {
    "name": "t:settings_schema.quick_style.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.quick_style.info"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "t:settings_schema.quick_style.accent.label",
        "default": "#1E6B4F"
      },
      {
        "type": "select",
        "id": "color_mode",
        "label": "t:settings_schema.quick_style.color_mode.label",
        "default": "light",
        "options": [
          {
            "value": "light",
            "label": "t:settings_schema.quick_style.color_mode.light"
          },
          {
            "value": "dark",
            "label": "t:settings_schema.quick_style.color_mode.dark"
          }
        ]
      },
      {
        "type": "select",
        "id": "heading_style",
        "label": "t:settings_schema.quick_style.heading_style.label",
        "default": "sans",
        "options": [
          {
            "value": "sans",
            "label": "t:settings_schema.quick_style.heading_style.sans"
          },
          {
            "value": "serif",
            "label": "t:settings_schema.quick_style.heading_style.serif"
          }
        ]
      },
      {
        "type": "select",
        "id": "corners",
        "label": "t:settings_schema.quick_style.corners.label",
        "default": "soft",
        "options": [
          {
            "value": "sharp",
            "label": "t:settings_schema.quick_style.corners.sharp"
          },
          {
            "value": "soft",
            "label": "t:settings_schema.quick_style.corners.soft"
          },
          {
            "value": "round",
            "label": "t:settings_schema.quick_style.corners.round"
          },
          {
            "value": "custom",
            "label": "t:settings_schema.quick_style.corners.custom"
          }
        ]
      },
      {
        "type": "range",
        "id": "radius_card",
        "label": "t:settings_schema.quick_style.radius_card.label",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 12,
        "visible_if": "{{ settings.corners == 'custom' }}"
      },
      {
        "type": "range",
        "id": "radius_small",
        "label": "t:settings_schema.quick_style.radius_small.label",
        "min": 0,
        "max": 24,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ settings.corners == 'custom' }}"
      },
      {
        "type": "checkbox",
        "id": "button_pill",
        "label": "t:settings_schema.quick_style.button_pill.label",
        "default": true,
        "visible_if": "{{ settings.corners == 'custom' }}"
      },
      {
        "type": "range",
        "id": "radius_button",
        "label": "t:settings_schema.quick_style.radius_button.label",
        "min": 0,
        "max": 32,
        "step": 1,
        "unit": "px",
        "default": 8,
        "visible_if": "{{ settings.corners == 'custom' and settings.button_pill == false }}"
      }
    ]
  },
