{% doc %}
  A product card placeholder for sections without a collection yet (theme editor).
{% enddoc %}
<div class="bp-card">
  <span class="bp-media bp-ratio-square bp-card__media">{{ 'product-1' | placeholder_svg_tag: 'bp-media__img' }}</span>
  <span class="bp-card__title">{{ 'sections.featured_collection.placeholder' | t }}</span>
</div>
