{% doc %}
  Everything a layout's <head> needs before {{ content_for_header }}: meta tags,
  tokens, base CSS and the two scripts every page loads.

  Fonts aren't preloaded: they swap in (font_display: swap), and on a mobile connection
  two preloaded fonts held back the product photo enough to cost about 15 Lighthouse
  points (measured on a demo store, docs/PLAN.md). They come from the store's own
  domain, so no preconnect either.

  The inline script swaps "no-js" for "js" before first paint: doing it later
  (in a module) would re-flow the header and cause layout shift.

  bp-standard-actions.js must come before {{ content_for_header }}: Shopify only
  keeps the first handler configured for each Standard Action.
{% enddoc %}
<meta charset="utf-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
  document.documentElement.classList.replace('no-js', 'js');
</script>
{%- render 'head-meta' -%}
{%- render 'tokens' -%}
{{ 'base.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bp-core.js' | asset_url }}" type="module"></script>
<script src="{{ 'bp-standard-actions.js' | asset_url }}" type="module"></script>
