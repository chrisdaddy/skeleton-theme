{% doc %}
  The cart facts bp-cart.js needs to keep gifts and protection right, as JSON.

  @param {number} protection_id - The shipping protection variant ID
  @param {number} basis - Merchandise value in cents (rewards basis)
  @param {number} merch_count - Merchandise units
{% enddoc %}
{%- capture thresholds -%}{%- render 'cart-reward-thresholds' -%}{%- endcapture -%}
{%- assign thresholds = thresholds | strip | split: ',' -%}
<script type="application/json" data-bp-cart-state>
  {
    "count": {{ cart.item_count }},
    "countLabel": {{ 'cart.item_count' | t: count: cart.item_count | json }},
    "basis": {{ basis }},
    "merch": {{ merch_count }},
    "protection": {{ protection_id | default: 'null' }},
    "protectionDefault": {{ settings.cart_protection_default | json }},
    "rewards": [
      {%- if settings.cart_rewards_enabled -%}
        {%- for i in (1..3) -%}
          {%- liquid
            assign index = i | minus: 1
            assign threshold = thresholds[index] | plus: 0
            assign gift_key = 'cart_reward_' | append: i | append: '_gift'
            assign gift_variant = settings[gift_key].selected_or_first_available_variant
          -%}
          {"index": {{ i }}, "threshold": {{ threshold }}, "gift": {% if gift_variant.available %}{{ gift_variant.id }}{% else %}null{% endif %}}
          {%- unless forloop.last %},{% endunless -%}
        {%- endfor -%}
      {%- endif -%}
    ],
    "items": [
      {%- for item in cart.items -%}
        {%- liquid
          assign discounted = false
          if item.final_line_price < item.original_line_price
            assign discounted = true
          endif
        -%}
        {"key": {{ item.key | json }}, "id": {{ item.variant_id }}, "quantity": {{ item.quantity }},
         "gift": {{ item.properties._bp_gift | default: '' | json }}, "reward": {{ item.properties._bp_reward | default: 0 | plus: 0 }},
         "for": {{ item.properties._bp_gift_for | default: 0 | plus: 0 }}, "discounted": {{ discounted }},
         "price": {{ item.final_line_price }}, "title": {{ item.product.title | json }}}
        {%- unless forloop.last %},{% endunless -%}
      {%- endfor -%}
    ]
  }
</script>
