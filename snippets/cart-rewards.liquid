{% doc %}
  Rewards bar: progress towards up to three rewards, and a claim form for any unlocked
  gift that isn't in the cart (bp-cart.js adds gifts automatically unless the shopper
  removed one; without JS the form is how a gift gets added).

  @param {number} basis - Merchandise value in cents after line discounts, without gifts or protection
  @param {number} merch_count - Merchandise units in the cart
  @param {string} gift_keys - Gift lines in the cart, as ",reward-1,tier-123,"
{% enddoc %}
{%- liquid
  capture thresholds
    render 'cart-reward-thresholds'
  endcapture
  assign thresholds = thresholds | strip | split: ','
  assign goal = 0
  for i in (1..3)
    assign index = i | minus: 1
    assign threshold = thresholds[index] | plus: 0
    assign label_key = 'cart_reward_' | append: i | append: '_label'
    if threshold > goal and settings[label_key] != blank
      assign goal = threshold
    endif
  endfor
-%}
{%- if goal > 0 -%}
  {%- liquid
    assign percent = basis | times: 100 | divided_by: goal | at_most: 100
    assign next_label = ''
    assign last_label = ''
    for i in (1..3)
      assign index = i | minus: 1
      assign threshold = thresholds[index] | plus: 0
      assign label_key = 'cart_reward_' | append: i | append: '_label'
      if threshold > 0 and settings[label_key] != blank
        assign last_label = settings[label_key]
        if threshold > basis and next_label == blank
          assign next_label = settings[label_key]
          assign remaining = threshold | minus: basis
        endif
      endif
    endfor
  -%}
  <div class="bp-rewards">
    <p class="bp-rewards__message">
      {%- if next_label != blank -%}
        {%- assign amount = remaining | money -%}
        {{- 'cart.rewards.away' | t: amount: amount, reward: next_label -}}
      {%- else -%}
        {{- 'cart.rewards.all_unlocked' | t: reward: last_label -}}
      {%- endif -%}
    </p>
    <div class="bp-rewards__track" aria-hidden="true">
      <span class="bp-rewards__fill" style="--bp-progress: {{ percent }}%;"></span>
    </div>
    <ol class="bp-rewards__steps" role="list" aria-label="{{ 'cart.rewards.label' | t }}">
      {%- for i in (1..3) -%}
        {%- liquid
          assign index = i | minus: 1
          assign threshold = thresholds[index] | plus: 0
          assign label_key = 'cart_reward_' | append: i | append: '_label'
          assign label = settings[label_key]
          assign position = threshold | times: 100 | divided_by: goal
        -%}
        {%- if threshold > 0 and label != blank -%}
          <li
            class="bp-rewards__step"
            style="--bp-at: {{ position }}%;"
            {% if basis >= threshold %}
              data-unlocked
            {% endif %}
          >
            {%- if basis >= threshold -%}
              {%- render 'icon', name: 'check' -%}
            {%- endif -%}
            <span>{{ label | escape }}</span>
            <span class="bp-visually-hidden">{{ threshold | money }}</span>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ol>

    {%- for i in (1..3) -%}
      {%- liquid
        assign index = i | minus: 1
        assign threshold = thresholds[index] | plus: 0
        assign gift_key = 'cart_reward_' | append: i | append: '_gift'
        assign gift_product = settings[gift_key]
        assign gift_variant = gift_product.selected_or_first_available_variant
        assign marker = ',reward-' | append: i | append: ','
      -%}
      {%- if threshold > 0 and basis >= threshold and merch_count > 0 and gift_variant.available -%}
        {%- unless gift_keys contains marker -%}
          <form
            action="{{ routes.cart_add_url }}"
            method="post"
            class="bp-cart-gift-claim"
            data-bp-cart-add
            data-bp-gift-claim="reward-{{ i }}"
          >
            <input type="hidden" name="id" value="{{ gift_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="properties[_bp_gift]" value="reward">
            <input type="hidden" name="properties[_bp_reward]" value="{{ i }}">
            <button type="submit" class="bp-button bp-button--secondary bp-button--small">
              {%- render 'icon', name: 'gift' -%}
              {{ 'cart.add_gift' | t: title: gift_product.title }}
            </button>
          </form>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
{%- endif -%}
