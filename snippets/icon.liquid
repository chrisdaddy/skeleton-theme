    when 'chevron-down'
      assign path = 'M6 9l6 6 6-6'
    when 'chevron-left'
      assign path = 'M15 6l-6 6 6 6'
    when 'chevron-right'
      assign path = 'M9 6l6 6-6 6'
    when 'pause'
      assign path = 'M9 6v12M15 6v12'
    when 'play'
      assign path = 'M8 5.5v13l10-6.5-10-6.5z'
    when 'instagram'
      assign path = 'M7 3h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V7a4 4 0 0 1 4-4zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM17.5 6.5h.01'
