      assign path = 'M12 3a9 9 0 0 0-3.3 17.4c0-.8 0-1.8.2-2.6l1.3-5.4s-.3-.7-.3-1.6c0-1.5.9-2.6 2-2.6.9 0 1.4.7 1.4 1.6 0 1-.6 2.4-.9 3.7-.3 1.1.6 2 1.7 2 2 0 3.4-2.6 3.4-5.7 0-2.3-1.6-4.1-4.5-4.1-3.3 0-5.3 2.4-5.3 5.1 0 .9.3 1.6.7 2.1'
  endcase
-%}
<svg
  class="bp-icon{% if filled %} bp-icon--fill{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
