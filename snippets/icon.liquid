{% doc %}
  Inline SVG icon. Line icons use currentColor, so they follow the text color.

  @param {string} name - menu, close, search, account, cart, chevron-down, chevron-left, chevron-right, pause, play, instagram, tiktok, facebook, youtube, x, pinterest
  @param {string} [class] - Extra classes
{% enddoc %}
{%- liquid
  assign filled = false
