{% doc %}
  Renders the document title, description, canonical link and social sharing tags.
{% enddoc %}
{%- liquid
  assign share_title = page_title | default: shop.name
  assign share_description = page_description | default: shop.description | default: shop.name
  assign share_type = 'website'
  case request.page_type
    when 'product'
      assign share_type = 'product'
    when 'article'
      assign share_type = 'article'
  endcase
-%}
<title>
  {{- page_title -}}
  {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
  {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: number: current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>
{%- if page_description %}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif %}
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon %}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
{%- endif %}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ share_title | escape }}">
<meta property="og:type" content="{{ share_type }}">
<meta property="og:description" content="{{ share_description | escape }}">
{%- if page_image %}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ share_title | escape }}">
<meta name="twitter:description" content="{{ share_description | escape }}">
