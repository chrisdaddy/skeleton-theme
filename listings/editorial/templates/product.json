          "type": "feature",
          "settings": {
            "kicker": "Top · 0–20 min",
            "title": "Fig leaf and pink pepper",
            "text": "<p>Green and a little sharp, like a garden in June.</p>"
          }
        },
        "feature_2": {
          "type": "feature",
          "settings": {
            "kicker": "Heart · 1–4 h",
            "title": "Iris pallida",
            "text": "<p>Powdery, cool, expensive. The reason it exists.</p>"
          }
        },
        "feature_3": {
          "type": "feature",
          "settings": {
            "kicker": "Base · all day",
            "title": "Skin musk and ambrette",
            "text": "<p>Warm and close. Smells like you, on a good day.</p>"
          }
        }
      },
