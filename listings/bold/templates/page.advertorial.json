        "text_2": {
          "type": "text",
          "settings": {
            "text": "<p>I have taken whey for twelve years and I had never read a certificate of analysis. Then a lifter at my gym failed a drug test off a clean-labelled pre-workout.</p>"
          }
        },
        "quote_3": {
          "type": "quote",
          "settings": {
            "quote": "<p>Nine of twelve under-delivered on protein. One was spiked with cheap aminos. Rawform matched to the gram.</p>"
          }
        },
        "text_4": {
          "type": "text",
          "settings": {
            "text": "<p>Keep every claim specific and true: what they tried before, what changed and when. Link the study, show the label, say what it costs.</p>"
          }
        },
        "product_5": {
          "type": "product",
          "settings": {
