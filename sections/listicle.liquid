{{ 'section-content.css' | asset_url | stylesheet_tag }}
{{ 'section-landing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign items = section.blocks | where: 'type', 'item'
  assign count = items.size | append: ''
  assign heading = s.heading | replace: '[count]', count
  # Item titles sit one level below the list's heading.
  assign item_tag = 'h3'
  if heading == blank
    assign item_tag = 'h2'
  elsif s.heading_tag == 'h1'
    assign item_tag = 'h2'
  elsif s.heading_tag == 'h3'
    assign item_tag = 'h4'
  endif
-%}
<section {% render 'section-attributes', section: section, name: 'listicle', modifier: s.image_side %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section, heading: heading -%}
    <ol class="bp-listicle__items" role="list">
      {%- for block in items -%}
        <li class="bp-listicle__item" {{ block.shopify_attributes }}>
          <div class="bp-media bp-ratio-landscape bp-listicle__media">
            {%- render 'section-image', image: block.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', section: section, width: 1400 -%}
          </div>
          <div class="bp-listicle__text">
            <{{ item_tag }} class="bp-h3">
              {%- if s.numbering -%}<span class="bp-listicle__number">{{ forloop.index }}</span>{%- endif -%}
              {{ block.settings.title | escape }}
            </{{ item_tag }}>
            {%- if block.settings.text != blank -%}<div class="bp-rte bp-muted-rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- render 'cta-button', label: block.settings.cta_label, product: block.settings.cta_product, tier: block.settings.cta_tier, plan: block.settings.cta_plan, link: block.settings.cta_link, class: 'bp-link-arrow' -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.listicle.name",
  "max_blocks": 40,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "[count] reasons people switch",
      "info": "[count] becomes the number of items."
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.common.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "center",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "numbering",
      "label": "t:sections.listicle.settings.numbering.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.listicle.settings.image_side.label",
      "default": "alternate",
      "options": [
        {
          "value": "left",
          "label": "t:sections.listicle.settings.image_side.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.listicle.settings.image_side.options.right"
        },
        {
          "value": "alternate",
          "label": "t:sections.listicle.settings.image_side.options.alternate"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "t:sections.common.settings.heading_tag.options.h1"
        },
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ],
      "info": "t:sections.common.settings.heading_tag.info"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.listicle.blocks.item.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.settings.image.label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.listicle.blocks.item.settings.title.label",
          "default": "A reason worth a heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.common.settings.text.label",
          "default": "<p>Back it up in two or three sentences.</p>"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "t:sections.listicle.blocks.item.settings.cta_label.label"
        },
        {
          "type": "product",
          "id": "cta_product",
          "label": "t:sections.listicle.blocks.item.settings.cta_product.label",
          "info": "t:sections.listicle.blocks.item.settings.cta_product.info"
        },
        {
          "type": "range",
          "id": "cta_tier",
          "label": "t:sections.listicle.blocks.item.settings.cta_tier.label",
          "min": 0,
          "max": 6,
          "step": 1,
          "default": 0,
          "info": "t:sections.listicle.blocks.item.settings.cta_tier.info"
        },
        {
          "type": "select",
          "id": "cta_plan",
          "label": "t:sections.listicle.blocks.item.settings.cta_plan.label",
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "t:sections.listicle.blocks.item.settings.cta_plan.options.default"
            },
            {
              "value": "once",
              "label": "t:sections.listicle.blocks.item.settings.cta_plan.options.once"
            },
            {
              "value": "sub",
              "label": "t:sections.listicle.blocks.item.settings.cta_plan.options.sub"
            }
          ]
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "t:sections.listicle.blocks.item.settings.cta_link.label",
          "info": "t:sections.listicle.blocks.item.settings.cta_link.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.listicle.presets.listicle.name",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
