<div class="bp-page-width bp-page-width--narrow bp-stack bp-center">
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p>{{ shop.password_message }}</p>
  {%- endif -%}
  {%- form 'storefront_password', class: 'bp-stack' -%}
    {{ form.errors | default_errors }}
    <label for="Password">{{ 'password.label' | t }}</label>
    <input id="Password" type="password" name="password" autocomplete="current-password">
    <button type="submit" class="bp-button">{{ 'password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": []
}
{% endschema %}
