{{ 'section-content.css' | asset_url | stylesheet_tag }}
<section {% render 'section-attributes', section: section, name: 'password-page' %}>
  <div class="bp-page-width bp-page-width--{{ section.settings.width }} bp-richtext__inner bp-richtext--center">
    <h1 class="bp-h1">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}<p class="bp-richtext__text">{{ shop.password_message }}</p>{%- endif -%}
    {%- render 'newsletter-form', id: 'PasswordNewsletter' -%}
    <details class="bp-accordion bp-password__login">
      <summary class="bp-accordion__summary"><span>{{ 'password.owner' | t }}</span>{%- render 'icon', name: 'plus', class: 'bp-accordion__toggle' -%}</summary>
      {%- form 'storefront_password', class: 'bp-stack bp-accordion__content' -%}
        {%- if form.errors -%}<div class="bp-form-message" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <label class="bp-label" for="Password">{{ 'password.label' | t }}</label>
        <div class="bp-input-group">
          <input id="Password" class="bp-input" type="password" name="password" autocomplete="current-password">
          <button type="submit" class="bp-button">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "narrow",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ]
}
{% endschema %}
