{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign source = s.product | default: product
  assign certifications = ''
  if s.use_metafield
    assign certifications = source.metafields.blueprint.certifications.value
  endif
-%}
{%- if certifications != blank or section.blocks.size > 0 -%}
  <section {% render 'section-attributes', section: section, name: 'badges', modifier: s.style %}>
    <div class="bp-page-width bp-page-width--{{ s.width }}">
      {%- if s.heading != blank -%}
        <h2 class="bp-visually-hidden" id="Heading-{{ section.id }}">{{ s.heading }}</h2>
      {%- endif -%}
      <ul class="bp-badges__list bp-badges__list--{{ s.alignment }}" role="list">
        {%- if certifications != blank -%}
          {%- for text in certifications -%}
            <li class="bp-badges__item">
              <span class="bp-badges__icon">{%- render 'icon', name: 'check' -%}</span>
              {{- text | escape -}}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li class="bp-badges__item" {{ block.shopify_attributes }}>
              <span class="bp-badges__icon">{%- render 'icon', name: block.settings.icon -%}</span>
              {{- block.settings.text | escape -}}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </section>
{%- endif -%}

