{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'tabs' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section -%}
    <bp-tabs class="bp-tabs" data-bp-module="{{ 'bp-tabs.js' | asset_url }}" data-bp-load="visible">
      {%- for block in section.blocks -%}
        <div class="bp-tabs__panel" id="Tab-{{ block.id }}" {{ block.shopify_attributes }}>
          <h3 class="bp-tabs__title bp-h4">{{ block.settings.title | escape }}</h3>
          <div class="bp-rte">
            {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- else -%}{{ block.settings.content }}{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </bp-tabs>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.content_tabs.name",
  "max_blocks": 6,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "narrow",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:sections.content_tabs.blocks.tab.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.content_tabs.blocks.tab.settings.title.label",
          "default": "Tab"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:sections.content_tabs.blocks.tab.settings.content.label",
          "default": "<p>Use tabs for details shoppers look up: directions, shipping, care.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.content_tabs.blocks.tab.settings.page.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.content_tabs.presets.content_tabs.name",
      "blocks": [
        {
          "type": "tab",
          "settings": {
            "title": "How to use"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Shipping"
          }
        },
        {
          "type": "tab",
          "settings": {
            "title": "Returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}
