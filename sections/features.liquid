{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'features', modifier: s.layout %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section -%}
    <div class="bp-features__list{% if s.layout == 'grid' %} bp-cols{% endif %}" {% if s.layout == 'grid' %}style="--bp-cols: {{ section.blocks.size | at_most: 3 }};"{% endif %}>
      {%- for block in section.blocks -%}
        <article class="bp-feature" {{ block.shopify_attributes }}>
          <div class="bp-media bp-ratio-{{ s.image_ratio }} bp-feature__media">
            {%- render 'section-image', image: block.settings.image, sizes: '(min-width: 990px) 50vw, 100vw', section: section, width: 1400 -%}
          </div>
          <div class="bp-feature__text">
            {%- if block.settings.kicker != blank -%}<p class="bp-kicker">{{ block.settings.kicker | escape }}</p>{%- endif -%}
            <h3 class="bp-h3">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.text != blank -%}<div class="bp-rte bp-muted-rte">{{ block.settings.text }}</div>{%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link != blank -%}
              <a class="bp-link-arrow" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.features.name",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "How it's made"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.common.settings.subheading.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.features.settings.layout.label",
      "default": "alternating",
      "options": [
        {
          "value": "alternating",
          "label": "t:sections.features.settings.layout.options.alternating"
        },
        {
          "value": "grid",
          "label": "t:sections.features.settings.layout.options.grid"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.features.settings.image_ratio.label",
      "default": "landscape",
      "options": [
        {
          "value": "square",
          "label": "t:sections.features.settings.image_ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.features.settings.image_ratio.options.landscape"
        },
        {
          "value": "portrait",
          "label": "t:sections.features.settings.image_ratio.options.portrait"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:sections.features.blocks.feature.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.settings.image.label"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "t:sections.features.blocks.feature.settings.kicker.label",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.features.blocks.feature.settings.title.label",
          "default": "Name the feature"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.common.settings.text.label",
          "default": "<p>Explain why it matters, in a sentence or two.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:sections.features.blocks.feature.settings.link_label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.features.blocks.feature.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.features.presets.alternating_features.name",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    },
    {
      "name": "t:sections.features.presets.feature_grid.name",
      "settings": {
        "layout": "grid",
        "image_ratio": "square"
      },
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
