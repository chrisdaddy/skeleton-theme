{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'contact' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section -%}
    {%- form 'contact', class: 'bp-stack bp-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="bp-form-message" role="status">{{ 'contact.success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="bp-form-message" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="bp-field">
        <label class="bp-label" for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
        <input id="ContactName-{{ section.id }}" class="bp-input" type="text" name="contact[name]" autocomplete="name">
      </div>
      <div class="bp-field">
        <label class="bp-label" for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
        <input id="ContactEmail-{{ section.id }}" class="bp-input" type="email" name="contact[email]" autocomplete="email" required>
      </div>
      <div class="bp-field">
        <label class="bp-label" for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
        <textarea class="bp-input" id="ContactBody-{{ section.id }}" name="contact[body]" rows="6"></textarea>
      </div>
      <button type="submit" class="bp-button">{{ 'contact.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Contact us"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.common.settings.subheading.label",
      "default": "We answer within one business day."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "narrow",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.presets.contact_form.name"
    }
  ]
}
{% endschema %}
