<div class="bp-page-width bp-page-width--narrow bp-stack">
  {%- if section.settings.heading != blank -%}
    <h2>{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- form 'contact', class: 'bp-stack' -%}
    {%- if form.posted_successfully? -%}
      <p role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {{ form.errors | default_errors }}
    <label for="ContactName-{{ section.id }}">{{ 'contact.name' | t }}</label>
    <input id="ContactName-{{ section.id }}" type="text" name="contact[name]" autocomplete="name">
    <label for="ContactEmail-{{ section.id }}">{{ 'contact.email' | t }}</label>
    <input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
    <label for="ContactBody-{{ section.id }}">{{ 'contact.message' | t }}</label>
    <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="6"></textarea>
    <button type="submit" class="bp-button">{{ 'contact.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.contact_form.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Contact us"
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.name"
    }
  ]
}
{% endschema %}
