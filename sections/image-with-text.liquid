{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'imagetext', modifier: s.image_side %}>
  <div class="bp-page-width bp-page-width--{{ s.width }} bp-imagetext__inner">
    <div class="bp-media bp-ratio-{{ s.image_ratio }} bp-imagetext__media">
      {%- render 'section-image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', section: section -%}
    </div>
    <div class="bp-imagetext__text">
      {%- if s.eyebrow != blank -%}<p class="bp-kicker">{{ s.eyebrow | escape }}</p>{%- endif -%}
      {%- if s.heading != blank -%}
        {%- assign tag = s.heading_tag | default: 'h2' -%}
        <{{ tag }} class="bp-h2" id="Heading-{{ section.id }}">{{ s.heading }}</{{ tag }}>
      {%- endif -%}
      {%- if s.text != blank -%}<div class="bp-rte bp-muted-rte">{{ s.text }}</div>{%- endif -%}
      {%- if s.button_label != blank -%}
        <a class="{% if s.button_style == 'link' %}bp-link-arrow{% else %}bp-button{% endif %}" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.common.settings.image.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.common.settings.eyebrow.label",
      "default": "Kicker"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Tell the story behind the product"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.common.settings.text.label",
      "default": "<p>Pair a strong image with two or three sentences.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.common.settings.button_label.label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.common.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:sections.image_with_text.settings.button_style.label",
      "default": "button",
      "options": [
        {
          "value": "button",
          "label": "t:sections.image_with_text.settings.button_style.options.button"
        },
        {
          "value": "link",
          "label": "t:sections.image_with_text.settings.button_style.options.link"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "t:sections.image_with_text.settings.image_side.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.settings.image_side.options.left"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.settings.image_side.options.right"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image_with_text.settings.image_ratio.label",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "t:sections.image_with_text.settings.image_ratio.options.square"
        },
        {
          "value": "landscape",
          "label": "t:sections.image_with_text.settings.image_ratio.options.landscape"
        },
        {
          "value": "portrait",
          "label": "t:sections.image_with_text.settings.image_ratio.options.portrait"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.image_with_text.name"
    },
    {
      "name": "t:sections.image_with_text.presets.image_with_text_right.name",
      "settings": {
        "image_side": "right"
      }
    }
  ]
}
{% endschema %}
