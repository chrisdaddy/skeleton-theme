{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign pill_filter = ''
  if s.show_pills
    for filter in collection.filters
      if filter.type == 'list' and pill_filter == blank
        if s.pill_filter_label == blank or filter.label == s.pill_filter_label
          assign pill_filter = filter
        endif
      endif
    endfor
  endif
-%}
<section {% render 'section-attributes', section: section, name: 'collection-grid' %}>
  <bp-facets
    class="bp-page-width bp-page-width--{{ s.width }} bp-facets"
    data-section-id="{{ section.id }}"
    data-bp-module="{{ 'bp-facets.js' | asset_url }}"
    data-bp-load="idle"
  >
    {%- paginate collection.products by s.per_page -%}
      <div class="bp-facets__results" data-bp-facets-results>
        {%- if pill_filter != blank -%}
          <nav class="bp-pills" aria-label="{{ pill_filter.label | escape }}">
            <ul role="list">
              <li><a class="bp-pill-link" href="{{ pill_filter.url_to_remove }}" {% if pill_filter.active_values.size == 0 %}aria-current="page"{% endif %}>{{ 'collections.all' | t }}</a></li>
              {%- for value in pill_filter.values -%}
                {%- if value.count > 0 or value.active -%}
                  <li>
                    <a class="bp-pill-link" href="{% if value.active %}{{ value.url_to_remove }}{% else %}{{ value.url_to_add }}{% endif %}" {% if value.active %}aria-current="page"{% endif %}>{{ value.label | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <form class="bp-facets__form" action="{{ collection.url }}" method="get" data-bp-facets-form>
          <div class="bp-facets__toolbar">
            <p class="bp-facets__count" role="status">{{ 'collections.product_count' | t: count: collection.products_count }}</p>
            {%- if s.show_filters and collection.filters.size > 0 -%}
              <details class="bp-facets__panel" data-bp-facets-panel>
                <summary class="bp-button bp-button--secondary bp-button--small">
                  {%- render 'icon', name: 'layers' -%}
                  {{ 'collections.filters' | t }}
                  {%- assign active_count = 0 -%}
                  {%- for filter in collection.filters -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}{%- assign active_count = active_count | plus: 1 -%}{%- endif -%}
                    {%- else -%}
                      {%- assign active_count = active_count | plus: filter.active_values.size -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if active_count > 0 %} ({{ active_count }}){% endif -%}
                </summary>
                <div class="bp-facets__filters">
                  {%- for filter in collection.filters -%}
                    <fieldset class="bp-facets__group">
                      <legend class="bp-facets__legend">{{ filter.label | escape }}</legend>
                      {%- case filter.type -%}
                        {%- when 'price_range' -%}
                          {%- liquid
                            # Shopify gives price filter values in cents; the inputs take currency units.
                            assign price_min = ''
                            assign price_max = ''
                            if filter.min_value.value != blank
                              assign price_min = filter.min_value.value | divided_by: 100.0
                            endif
                            if filter.max_value.value != blank
                              assign price_max = filter.max_value.value | divided_by: 100.0
                            endif
                            assign range_max = filter.range_max | divided_by: 100.0 | ceil
                          -%}
                          <div class="bp-facets__price">
                            <label class="bp-field">
                              <span class="bp-label">{{ 'collections.price_from' | t }}</span>
                              <input class="bp-input" type="number" inputmode="decimal" min="0" step="1" name="{{ filter.min_value.param_name }}" value="{{ price_min }}" placeholder="0">
                            </label>
                            <label class="bp-field">
                              <span class="bp-label">{{ 'collections.price_to' | t }}</span>
                              <input class="bp-input" type="number" inputmode="decimal" min="0" step="1" name="{{ filter.max_value.param_name }}" value="{{ price_max }}" placeholder="{{ range_max }}">
                            </label>
                          </div>
                        {%- else -%}
                          <ul class="bp-facets__values" role="list">
                            {%- for value in filter.values -%}
                              <li>
                                <label class="bp-facets__value{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                                  <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                                  <span>{{ value.label | escape }}</span>
                                  <span class="bp-muted">({{ value.count }})</span>
                                </label>
                              </li>
                            {%- endfor -%}
                          </ul>
                      {%- endcase -%}
                    </fieldset>
                  {%- endfor -%}
                  <div class="bp-facets__actions">
                    <button type="submit" class="bp-button bp-button--small" data-bp-facets-apply>{{ 'collections.apply' | t }}</button>
                    <a class="bp-link bp-small" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a>
                  </div>
                </div>
              </details>
            {%- endif -%}
            {%- if s.show_sort -%}
              <label class="bp-facets__sort">
                <span class="bp-label">{{ 'collections.sort' | t }}</span>
                <select class="bp-select" name="sort_by">
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
                  {%- endfor -%}
                </select>
              </label>
              <noscript><button type="submit" class="bp-button bp-button--small">{{ 'collections.apply' | t }}</button></noscript>
            {%- endif -%}
          </div>
        </form>

        {%- liquid
          assign active = false
          for filter in collection.filters
            if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
              assign active = true
            endif
          endfor
        -%}
        {%- if active -%}
          <ul class="bp-facets__active" role="list" aria-label="{{ 'collections.active' | t }}">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <li><a class="bp-chip" href="{{ value.url_to_remove }}">{{ value.label | escape }} {%- render 'icon', name: 'close' -%}<span class="bp-visually-hidden">{{ 'collections.remove_filter' | t }}</span></a></li>
              {%- endfor -%}
              {%- if filter.type == 'price_range' and filter.min_value.value != blank or filter.type == 'price_range' and filter.max_value.value != blank -%}
                {%- assign min = filter.min_value.value | default: 0 | money -%}
                {%- assign max = '…' -%}
                {%- if filter.max_value.value != blank -%}{%- assign max = filter.max_value.value | money -%}{%- endif -%}
                <li><a class="bp-chip" href="{{ filter.url_to_remove }}">{{ min }}–{{ max }} {%- render 'icon', name: 'close' -%}<span class="bp-visually-hidden">{{ 'collections.remove_filter' | t }}</span></a></li>
              {%- endif -%}
            {%- endfor -%}
            <li><a class="bp-link bp-small" href="{{ collection.url }}?sort_by={{ sort_by }}">{{ 'collections.clear' | t }}</a></li>
          </ul>
        {%- endif -%}

        {%- if collection.products.size > 0 -%}
          <ul class="bp-cols bp-product-grid" role="list" style="--bp-cols: {{ s.columns }}; --bp-cols-mobile: {{ s.columns_mobile }};">
            {%- for product in collection.products -%}
              <li>{%- render 'product-card', product: product, show_rating: s.show_rating, show_badges: s.show_badges, quick_add: s.quick_add, sizes: '(min-width: 990px) 25vw, 50vw', section: section -%}</li>
            {%- endfor -%}
          </ul>
          {%- render 'pagination', paginate: paginate -%}
        {%- else -%}
          <div class="bp-facets__empty">
            <p>{{ 'collections.empty' | t }}</p>
            <a class="bp-button bp-button--secondary" href="{{ collection.url }}">{{ 'collections.clear' | t }}</a>
          </div>
        {%- endif -%}
      </div>
    {%- endpaginate -%}
  </bp-facets>
</section>

{% schema %}
{
  "name": "t:sections.main_collection_grid.name",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "label": "t:sections.main_collection_grid.settings.per_page.label",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.main_collection_grid.settings.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection_grid.settings.columns_mobile.label",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection_grid.settings.columns_mobile.options.1"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection_grid.settings.columns_mobile.options.2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:sections.main_collection_grid.settings.show_filters.label",
      "info": "t:sections.main_collection_grid.settings.show_filters.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pills",
      "label": "t:sections.main_collection_grid.settings.show_pills.label",
      "default": true
    },
    {
      "type": "text",
      "id": "pill_filter_label",
      "label": "t:sections.main_collection_grid.settings.pill_filter_label.label",
      "info": "t:sections.main_collection_grid.settings.pill_filter_label.info"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.main_collection_grid.settings.show_sort.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.main_collection_grid.settings.show_rating.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:sections.main_collection_grid.settings.show_badges.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "t:sections.main_collection_grid.settings.quick_add.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ]
}
{% endschema %}
