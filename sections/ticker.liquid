{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'ticker' %}>
  <div class="bp-marquee{% if s.direction == 'right' %} bp-marquee--reverse{% endif %}" style="--bp-marquee-duration: {{ 120 | divided_by: s.speed }}s;">
    <div class="bp-marquee__track">
      {%- for i in (1..2) -%}
        <ul class="bp-marquee__group bp-ticker__list" role="list" {% if forloop.index == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <li class="bp-ticker__item" {% if forloop.parentloop.index == 1 %}{{ block.shopify_attributes }}{% endif %}>
              {%- if block.settings.icon != 'none' -%}{%- render 'icon', name: block.settings.icon -%}{%- endif -%}
              <span>{{ block.settings.text | escape }}</span>
              <span class="bp-ticker__sep bp-ticker__sep--{{ s.separator }}" aria-hidden="true"></span>
            </li>
          {%- endfor -%}
        </ul>
      {%- endfor -%}
    </div>
  </div>
</section>

