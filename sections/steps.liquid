{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'steps', modifier: s.marker %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section -%}
    <ol class="bp-cols bp-steps__list" role="list" style="--bp-cols: {{ section.blocks.size | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <li class="bp-step" {{ block.shopify_attributes }}>
          <span class="bp-step__marker" aria-hidden="true">
            {%- if s.marker == 'icons' -%}{%- render 'icon', name: block.settings.icon -%}{%- else -%}{{ forloop.index }}{%- endif -%}
          </span>
          <h3 class="bp-step__title"><span class="bp-visually-hidden">{{ forloop.index }}. </span>{{ block.settings.title | escape }}</h3>
          <p class="bp-step__text">{{ block.settings.text | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

