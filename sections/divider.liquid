{%- assign s = section.settings -%}
<div {% render 'section-attributes', section: section, name: 'spacer' %} role="presentation">
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- if s.style == 'line' -%}<hr class="bp-divider__line">{%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.divider.name",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:sections.divider.settings.style.label",
      "default": "line",
      "options": [
        {
          "value": "line",
          "label": "t:sections.divider.settings.style.options.line"
        },
        {
          "value": "space",
          "label": "t:sections.divider.settings.style.options.space"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.divider.presets.divider.name"
    },
    {
      "name": "t:sections.divider.presets.spacer.name",
      "settings": {
        "style": "space",
        "padding_top": 40,
        "padding_bottom": 0
      }
    }
  ]
}
{% endschema %}
