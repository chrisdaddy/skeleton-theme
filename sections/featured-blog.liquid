{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign blog = s.blog
-%}
<section {% render 'section-attributes', section: section, name: 'blog' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    <div class="bp-collection__head">
      {%- render 'section-heading', section: section, align: 'start' -%}
      {%- if blog != blank -%}<a class="bp-link-arrow" href="{{ blog.url }}">{{ 'sections.featured_blog.view_all' | t }}</a>{%- endif -%}
    </div>
    <ul class="bp-cols" role="list" style="--bp-cols: {{ s.columns }};">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: s.count -%}
          <li class="bp-article-card">
            <a class="bp-media bp-ratio-landscape bp-article-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- render 'section-image', image: article.image, sizes: '(min-width: 990px) 33vw, 100vw', section: section, width: 1200, alt: '' -%}
            </a>
            {%- if s.show_date -%}<p class="bp-small bp-muted">{{ article.published_at | time_tag: format: 'date' }}</p>{%- endif -%}
            <h3 class="bp-h4"><a class="bp-article-card__title" href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            {%- if s.show_excerpt -%}<p class="bp-muted">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="bp-article-card">
            <span class="bp-media bp-ratio-landscape">{{ 'blog-apparel-1' | placeholder_svg_tag: 'bp-media__img' }}</span>
            <h3 class="bp-h4">{{ 'sections.featured_blog.placeholder' | t }}</h3>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_blog.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "From the journal"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.featured_blog.settings.blog.label"
    },
    {
      "type": "range",
      "id": "count",
      "label": "t:sections.featured_blog.settings.count.label",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_blog.settings.columns.label",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "t:sections.featured_blog.settings.show_date.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.featured_blog.settings.show_excerpt.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_blog.presets.blog_posts.name"
    }
  ]
}
{% endschema %}
