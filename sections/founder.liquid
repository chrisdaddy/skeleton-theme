{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'founder' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }} bp-founder__inner">
    <div class="bp-media bp-ratio-portrait bp-founder__media">
      {%- render 'section-image', image: s.image, sizes: '(min-width: 990px) 40vw, 100vw', section: section, placeholder: 'image' -%}
    </div>
    <figure class="bp-founder__text">
      <p class="bp-kicker" id="Heading-{{ section.id }}">{{ s.eyebrow | escape }}</p>
      <blockquote class="bp-founder__quote">{{ s.quote }}</blockquote>
      <figcaption class="bp-founder__by">
        {%- if s.signature != blank -%}
          {{ s.signature | image_url: width: 400 | image_tag: height: 48, loading: 'lazy', alt: '', class: 'bp-founder__signature' }}
        {%- endif -%}
        <span class="bp-founder__name">{{ s.name | escape }}</span>
        {%- if s.role != blank -%}<span class="bp-founder__role">{{ s.role | escape }}</span>{%- endif -%}
      </figcaption>
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.founder.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.common.settings.eyebrow.label",
      "default": "A note from the founder"
    },
    {
      "type": "richtext",
      "id": "quote",
      "label": "t:sections.founder.settings.quote.label",
      "default": "<p>Say why you started, in your own words.</p>"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:sections.founder.settings.name.label",
      "default": "Founder name"
    },
    {
      "type": "text",
      "id": "role",
      "label": "t:sections.founder.settings.role.label",
      "default": "Founder"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.founder.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "signature",
      "label": "t:sections.founder.settings.signature.label"
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.founder.presets.founder_note.name"
    }
  ]
}
{% endschema %}
