{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign source = s.product | default: product
  assign meta = ''
  if s.use_metafield
    assign meta = source.metafields.blueprint.guarantee.value
  endif
  assign heading = s.heading
  assign text = s.text
  assign days = s.days
  assign icon = s.icon
  if meta != blank
    assign heading = meta.title.value | default: heading
    assign text = meta.body.value | default: text
    assign days = meta.days.value | default: days
    assign icon = meta.icon.value | default: icon
  endif
-%}
<section {% render 'section-attributes', section: section, name: 'guarantee' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    <div class="bp-guarantee__card">
      <span class="bp-guarantee__badge" aria-hidden="true">
        {%- if days > 0 -%}
          <span class="bp-guarantee__days">{{ days }}</span><span class="bp-guarantee__unit">{{ 'sections.guarantee.days' | t }}</span>
        {%- else -%}
          {%- render 'icon', name: icon -%}
        {%- endif -%}
      </span>
      <div class="bp-guarantee__text">
        {%- assign tag = s.heading_tag | default: 'h2' -%}
        <{{ tag }} class="bp-h3" id="Heading-{{ section.id }}">{{ heading }}</{{ tag }}>
        {%- if text != blank -%}<div class="bp-rte">{{ text }}</div>{%- endif -%}
      </div>
      {%- if s.button_label != blank -%}
        <a class="bp-button" href="{{ s.button_link | default: source.url | default: routes.all_products_collection_url }}">{{ s.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

