{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'videos' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section, align: 'start' -%}
    <bp-slider class="bp-slider" data-bp-module="{{ 'bp-slider.js' | asset_url }}" data-bp-load="visible" data-label-previous="{{ 'general.previous' | t }}" data-label-next="{{ 'general.next' | t }}">
      <ul class="bp-scroller" role="list" tabindex="0" aria-label="{{ s.heading | strip_html | escape }}" style="--bp-cols: 3; --bp-slide-mobile: 72%;">
        {%- for block in section.blocks -%}
          <li class="bp-video-card" {{ block.shopify_attributes }}>
            <figure class="bp-video-card__figure">
              <bp-video
                class="bp-media bp-ratio-{{ s.aspect }} bp-video-card__media"
                {% if s.autoplay %}data-autoplay{% endif %}
                data-label-unmute="{{ 'sections.videos.unmute' | t }}"
                data-label-mute="{{ 'sections.videos.mute' | t }}"
                data-bp-module="{{ 'bp-video.js' | asset_url }}"
                data-bp-load="visible"
              >
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: image_size: '720x', controls: true, playsinline: true, preload: 'none', class: 'bp-video-card__video' }}
                {%- elsif block.settings.video_url != blank -%}
                  {%- if block.settings.poster != blank -%}
                    {{ block.settings.poster | image_url: width: 720 | image_tag: loading: 'lazy', class: 'bp-media__img', alt: '' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'bp-media__img' }}
                  {%- endif -%}
                  <button type="button" class="bp-video-card__play" data-bp-play>
                    {%- render 'icon', name: 'play' -%}
                    <span class="bp-visually-hidden">{{ 'sections.videos.play' | t: name: block.settings.name }}</span>
                  </button>
                  <template data-bp-embed>{{ block.settings.video_url | external_video_url: autoplay: true, rel: 0 | external_video_tag: loading: 'lazy' }}</template>
                  <noscript><a href="{{ block.settings.video_url }}">{{ 'sections.videos.watch' | t }}</a></noscript>
                {%- else -%}
                  {%- if block.settings.poster != blank -%}
                    {{ block.settings.poster | image_url: width: 720 | image_tag: loading: 'lazy', class: 'bp-media__img', alt: block.settings.poster.alt }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'bp-media__img' }}
                  {%- endif -%}
                {%- endif -%}
              </bp-video>
              {%- if block.settings.quote != blank or block.settings.name != blank -%}
                <figcaption class="bp-video-card__caption">
                  {%- if block.settings.quote != blank -%}<span class="bp-video-card__quote">“{{ block.settings.quote | escape }}”</span>{%- endif -%}
                  {%- if block.settings.name != blank -%}<span class="bp-video-card__name">{{ block.settings.name | escape }}</span>{%- endif -%}
                </figcaption>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
    </bp-slider>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.videos.name",
  "max_blocks": 10,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Hear it from them"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "select",
      "id": "aspect",
      "label": "t:sections.videos.settings.aspect.label",
      "default": "portrait",
      "options": [
        {
          "value": "tall",
          "label": "t:sections.videos.settings.aspect.options.tall"
        },
        {
          "value": "portrait",
          "label": "t:sections.videos.settings.aspect.options.portrait"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.videos.settings.autoplay.label",
      "info": "t:sections.videos.settings.autoplay.info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "t:sections.videos.blocks.video.name",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "t:sections.videos.blocks.video.settings.video.label",
          "info": "t:sections.videos.blocks.video.settings.video.info"
        },
        {
          "type": "video_url",
          "id": "video_url",
          "label": "t:sections.videos.blocks.video.settings.video_url.label",
          "accept": [
            "youtube",
            "vimeo"
          ]
        },
        {
          "type": "image_picker",
          "id": "poster",
          "label": "t:sections.videos.blocks.video.settings.poster.label",
          "info": "t:sections.videos.blocks.video.settings.poster.info"
        },
        {
          "type": "text",
          "id": "quote",
          "label": "t:sections.videos.blocks.video.settings.quote.label",
          "default": "One line they said in the video."
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.videos.blocks.video.settings.name.label",
          "default": "Name · Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.videos.presets.video_testimonials.name",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}
