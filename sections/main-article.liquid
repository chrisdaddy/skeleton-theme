<article class="bp-section bp-page-width bp-page-width--narrow bp-stack">
  <h1>{{ article.title | escape }}</h1>
  {%- assign published = article.published_at | time_tag: format: 'date' -%}
  <p class="bp-muted">{{ 'blog.byline' | t: author: article.author, date: published }}</p>
  {%- if article.image -%}
    {{
      article.image
      | image_url: width: 1400
      | image_tag:
        widths: '540, 720, 900, 1080, 1400',
        sizes: '(min-width: 990px) 760px, 100vw',
        loading: 'eager',
        fetchpriority: 'high'
    }}
  {%- endif -%}
  <div class="bp-rte">{{ article.content }}</div>
</article>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "settings": []
}
{% endschema %}
