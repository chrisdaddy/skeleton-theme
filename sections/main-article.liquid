{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<article {% render 'section-attributes', section: section, name: 'article-page' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }} bp-article-page__inner">
    <p class="bp-small"><a class="bp-link" href="{{ blog.url }}">{{ blog.title | escape }}</a></p>
    <h1 class="bp-h1">{{ article.title | escape }}</h1>
    {%- assign published = article.published_at | time_tag: format: 'date' -%}
    <p class="bp-muted">{{ 'blog.byline' | t: author: article.author, date: published }}</p>
    {%- if article.image -%}
      <div class="bp-media bp-ratio-wide">
        {%- render 'section-image', image: article.image, sizes: '(min-width: 990px) 760px, 100vw', section: section -%}
      </div>
    {%- endif -%}
    <div class="bp-rte bp-article-page__content">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <ul class="bp-inline-list bp-article-page__tags" role="list">
        {%- for tag in article.tags -%}<li><a class="bp-chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a></li>{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "t:sections.main_article.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "narrow",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ]
}
{% endschema %}
