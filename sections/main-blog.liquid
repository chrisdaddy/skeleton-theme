<div class="bp-page-width bp-stack">
  <h1>{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="bp-grid" role="list">
      {%- for article in blog.articles -%}
        <li class="bp-stack">
          {%- if article.image -%}
            {{
              article.image
              | image_url: width: 900
              | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy'
            }}
          {%- endif -%}
          <h2><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
          <p class="bp-muted">{{ article.published_at | time_tag: format: 'date' }}</p>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
        </li>
      {%- endfor -%}
    </ul>
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main_blog.name",
  "settings": []
}
{% endschema %}
