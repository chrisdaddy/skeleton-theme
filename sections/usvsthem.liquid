{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign source = s.product | default: product
  assign rows = ''
  assign them_label = s.them_label
  if s.use_metafield
    assign rows = source.metafields.blueprint.comparison.value
    if source.metafields.blueprint.comparison_competitor_label.value != blank
      assign them_label = source.metafields.blueprint.comparison_competitor_label.value
    endif
  endif
  assign us_label = s.us_label | default: shop.name
-%}
{%- if rows != blank or section.blocks.size > 0 or s.hide_empty == false -%}
  <section {% render 'section-attributes', section: section, name: 'usvsthem' %}>
    <div class="bp-page-width bp-page-width--{{ s.width }}">
      {%- render 'section-heading', section: section -%}
      <table class="bp-compare">
        <caption class="bp-visually-hidden">{{ s.heading | strip_html | escape }}</caption>
        <thead>
          <tr>
            <th scope="col" class="bp-compare__feature-head">{{ 'sections.usvsthem.feature' | t }}</th>
            <th scope="col" class="bp-compare__us">{{ us_label | escape }}</th>
            <th scope="col" class="bp-compare__them">{{ them_label | escape }}</th>
          </tr>
        </thead>
        <tbody>
          {%- if rows != blank -%}
            {%- for row in rows -%}
              <tr>
                <th scope="row">{{ row.feature.value | escape }}</th>
                <td class="bp-compare__us">{%- render 'compare-cell', value: row.us.value -%}</td>
                <td class="bp-compare__them">{%- render 'compare-cell', value: row.them.value -%}</td>
              </tr>
            {%- endfor -%}
          {%- else -%}
            {%- for block in section.blocks -%}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">{{ block.settings.feature | escape }}</th>
                <td class="bp-compare__us">{%- render 'compare-cell', value: block.settings.us -%}</td>
                <td class="bp-compare__them">{%- render 'compare-cell', value: block.settings.them -%}</td>
              </tr>
            {%- endfor -%}
          {%- endif -%}
        </tbody>
      </table>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.usvsthem.name",
  "max_blocks": 16,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Us vs. the alternative"
    },
    {
      "type": "text",
      "id": "us_label",
      "label": "t:sections.usvsthem.settings.us_label.label",
      "info": "t:sections.usvsthem.settings.us_label.info"
    },
    {
      "type": "text",
      "id": "them_label",
      "label": "t:sections.usvsthem.settings.them_label.label",
      "default": "The usual"
    },
    {
      "type": "paragraph",
      "content": "t:sections.usvsthem.settings.only_compare_things_you_can_back_up_read"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.common.settings.product.label",
      "info": "t:sections.common.settings.product.info"
    },
    {
      "type": "checkbox",
      "id": "use_metafield",
      "label": "t:sections.common.settings.use_metafield.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "t:sections.common.settings.hide_empty.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "narrow",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.usvsthem.blocks.row.name",
      "settings": [
        {
          "type": "text",
          "id": "feature",
          "label": "t:sections.usvsthem.blocks.row.settings.feature.label",
          "default": "Feature"
        },
        {
          "type": "text",
          "id": "us",
          "label": "t:sections.usvsthem.blocks.row.settings.us.label",
          "info": "t:sections.usvsthem.blocks.row.settings.us.info",
          "default": "yes"
        },
        {
          "type": "text",
          "id": "them",
          "label": "t:sections.usvsthem.blocks.row.settings.them.label",
          "info": "t:sections.usvsthem.blocks.row.settings.them.info",
          "default": "no"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.usvsthem.presets.us_vs_them.name",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
