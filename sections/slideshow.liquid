{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'slideshow' %} aria-roledescription="carousel" aria-label="{{ s.label | escape }}">
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    <bp-slider class="bp-slider" data-bp-module="{{ 'bp-slider.js' | asset_url }}" data-bp-load="visible" data-label-previous="{{ 'general.previous' | t }}" data-label-next="{{ 'general.next' | t }}" {% if s.autoplay %}data-autoplay="{{ s.speed }}"{% endif %} data-label-pause="{{ 'sections.slideshow.pause' | t }}" data-label-play="{{ 'sections.slideshow.play' | t }}">
      <ul class="bp-scroller bp-slideshow__track" role="list" tabindex="0" style="--bp-cols: 1; --bp-slide-mobile: 100%;">
        {%- for block in section.blocks -%}
          <li class="bp-slide" aria-roledescription="slide" aria-label="{{ 'sections.slideshow.slide' | t: current: forloop.index, total: forloop.length }}" {{ block.shopify_attributes }}>
            <div class="bp-banner__frame bp-banner__frame--{{ s.height }} bp-banner__frame--bottom-left" style="--bp-overlay: {{ block.settings.overlay | times: 0.01 }};">
              <div class="bp-banner__image">
                {%- render 'section-image', image: block.settings.image, sizes: '100vw', section: section -%}
              </div>
              <div class="bp-page-width bp-banner__over">
                <div class="bp-banner__content bp-banner__box">
                  {%- if block.settings.heading != blank -%}<h2 class="bp-h2">{{ block.settings.heading }}</h2>{%- endif -%}
                  {%- if block.settings.text != blank -%}<p class="bp-banner__sub">{{ block.settings.text }}</p>{%- endif -%}
                  {%- if block.settings.button_label != blank -%}<a class="bp-button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
                </div>
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </bp-slider>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.slideshow.name",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:sections.slideshow.settings.label.label",
      "default": "Featured"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.slideshow.settings.height.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.slideshow.settings.height.options.small"
        },
        {
          "value": "medium",
          "label": "t:sections.slideshow.settings.height.options.medium"
        },
        {
          "value": "large",
          "label": "t:sections.slideshow.settings.height.options.large"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "info": "t:sections.slideshow.settings.autoplay.info",
      "default": false
    },
    {
      "type": "range",
      "id": "speed",
      "label": "t:sections.slideshow.settings.speed.label",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 6,
      "visible_if": "{{ section.settings.autoplay }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "full",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.slideshow.blocks.slide.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.common.settings.image.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "t:sections.slideshow.blocks.slide.settings.heading.label",
          "default": "Slide heading"
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "t:sections.slideshow.blocks.slide.settings.text.label",
          "default": "One line to go with the image."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.slideshow.blocks.slide.settings.button_label.label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.slideshow.blocks.slide.settings.link.label"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "t:sections.slideshow.blocks.slide.settings.overlay.label",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.slideshow.presets.slideshow.name",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
