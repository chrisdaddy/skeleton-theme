{% comment %}
  Collection page: title, description and a paginated product grid.
  Phase 4 replaces this with the banner and the filterable grid (docs/PLAN.md §4.4).
{% endcomment %}
<div class="bp-section bp-page-width bp-stack">
  <h1>{{ collection.title | escape }}</h1>
  {%- if collection.description != blank -%}
    <div class="bp-rte">{{ collection.description }}</div>
  {%- endif -%}
  {%- paginate collection.products by section.settings.per_page -%}
    {%- render 'product-grid', products: collection.products -%}
    {%- render 'pagination', paginate: paginate -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "settings": [
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "label": "t:sections.main_collection.settings.per_page.label"
    }
  ]
}
{% endschema %}
