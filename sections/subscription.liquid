{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign source = s.product | default: product
  assign variant = source.selected_or_first_available_variant
  assign allocation = variant.selling_plan_allocations | sort: 'price' | first
  assign save_pct = ''
  if allocation != blank
    capture save_pct
      render 'offer-figure', variant: variant, quantity: 1, plan_id: allocation.selling_plan.id, field: 'plan_save_pct'
    endcapture
    assign save_pct = save_pct | strip
  endif
  assign heading = s.heading | replace: '[percent]', save_pct
  assign subheading = s.subheading | replace: '[percent]', save_pct
-%}
{%- unless s.heading contains '[percent]' and save_pct == blank -%}
  <section {% render 'section-attributes', section: section, name: 'subscription' %}>
    <div class="bp-page-width bp-page-width--{{ s.width }}">
      <div class="bp-subscription__card bp-card-surface">
        <div class="bp-subscription__head">
          {%- render 'section-heading', section: section, heading: heading, subheading: subheading, align: 'start' -%}
          {%- if s.button_label != blank -%}
            {%- liquid
              assign label = s.button_label | escape
              if allocation != blank
                assign price = allocation.price | money
                assign from = 'sections.subscription.from' | t: price: price
                assign label = label | append: ' · ' | append: from
              endif
              assign link = s.button_link
              if link == blank and source != blank
                assign link = source.url | append: '?plan=sub'
              endif
            -%}
            <a class="bp-button" href="{{ link | default: routes.all_products_collection_url }}">{{ label }}</a>
          {%- endif -%}
        </div>
        {%- if section.blocks.size > 0 -%}
          <ul class="bp-cols bp-subscription__tiles" role="list" style="--bp-cols: {{ section.blocks.size | at_most: 3 }};">
            {%- for block in section.blocks -%}
              <li class="bp-subscription__tile" {{ block.shopify_attributes }}>
                <span class="bp-subscription__icon">{%- render 'icon', name: block.settings.icon -%}</span>
                <h3 class="bp-subscription__title">{{ block.settings.title | escape }}</h3>
                <p class="bp-subscription__text">{{ block.settings.text | escape }}</p>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endunless -%}

