{% comment %}
  Cart drawer (docs/PLAN.md §8). Rendered once by layout/theme.liquid as a static section,
  so its Section Rendering ID is always "cart-drawer". Settings live in the theme settings
  (Cart group), shared with the cart page.

  The header's cart link stays a real link to the cart page; bp-core.js opens this drawer
  instead when it's on the page. Nothing renders on the cart page itself or when the
  merchant picks the page cart type.

  Its stylesheet loads as media="print" (fetched without blocking the first paint) and
  bp-cart.js switches it on before the dialog first opens: the closed dialog needs no styles.
{% endcomment %}
{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  <link rel="stylesheet" href="{{ 'component-cart.css' | asset_url }}" media="print" data-bp-cart-css>
  <bp-cart-drawer
    data-bp-module="{{ 'bp-cart.js' | asset_url }}"
    data-bp-load="idle"
  >
    <dialog
      id="CartDrawer"
      class="bp-drawer bp-drawer--right bp-cart-drawer"
      aria-labelledby="CartDrawer-Heading"
      closedby="any"
    >
      <bp-cart
        data-section-id="{{ section.id }}"
        data-section-url="{{ routes.root_url }}"
        data-cart-url="{{ routes.cart_url }}"
        data-error-message="{{ 'cart.error' | t | escape }}"
        data-status-template="{{ 'cart.status' | t: count: '[count]' | escape }}"
      >
        {%- render 'cart-contents', context: 'drawer', section_id: section.id -%}
        <p class="bp-visually-hidden" aria-live="polite" data-bp-cart-status></p>
        <p class="bp-form-message bp-cart__error" role="alert" data-bp-cart-error hidden></p>
      </bp-cart>
    </dialog>
  </bp-cart-drawer>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
