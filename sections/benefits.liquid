{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign source = s.product | default: product
  assign benefits = ''
  if s.use_metafield
    assign benefits = source.metafields.blueprint.benefits.value
  endif
-%}
{%- if benefits != blank or section.blocks.size > 0 or s.hide_empty == false -%}
  <section {% render 'section-attributes', section: section, name: 'benefit-grid', modifier: s.icon_style %}>
    <div class="bp-page-width bp-page-width--{{ s.width }}">
      {%- render 'section-heading', section: section -%}
      {%- capture items -%}
        {%- if benefits != blank -%}
          {%- for benefit in benefits -%}
            <li class="bp-benefit-card bp-card-surface">
              <span class="bp-benefit-card__icon">
                {%- if benefit.image.value != blank -%}
                  {{ benefit.image.value | image_url: width: 80 | image_tag: width: 22, height: 22, alt: '', loading: 'lazy' }}
                {%- else -%}
                  {%- render 'icon', name: benefit.icon.value -%}
                {%- endif -%}
              </span>
              <h3 class="bp-benefit-card__title">{{ benefit.title.value | escape }}</h3>
              {%- if benefit.text.value != blank -%}<p class="bp-benefit-card__text">{{ benefit.text.value | escape }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in section.blocks -%}
            <li class="bp-benefit-card bp-card-surface" {{ block.shopify_attributes }}>
              <span class="bp-benefit-card__icon">{%- render 'icon', name: block.settings.icon -%}</span>
              <h3 class="bp-benefit-card__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.text != blank -%}<p class="bp-benefit-card__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- if s.layout == 'slider' -%}
        <bp-slider class="bp-slider" data-bp-module="{{ 'bp-slider.js' | asset_url }}" data-bp-load="visible" data-label-previous="{{ 'general.previous' | t }}" data-label-next="{{ 'general.next' | t }}">
          <ul class="bp-scroller" role="list" style="--bp-cols: {{ s.columns }};" tabindex="0" aria-label="{{ s.heading | strip_html | escape }}">{{ items }}</ul>
        </bp-slider>
      {%- else -%}
        <ul class="bp-cols" role="list" style="--bp-cols: {{ s.columns }}; --bp-cols-mobile: {{ s.columns_mobile }};">{{ items }}</ul>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

