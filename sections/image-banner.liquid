{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'banner', modifier: s.layout %}>
  {%- if s.layout == 'split' -%}
    <div class="bp-page-width bp-page-width--{{ s.width }} bp-banner__split">
      <div class="bp-media bp-banner__media bp-banner__media--{{ s.height }}">
        {%- render 'section-image', image: s.image, sizes: '(min-width: 990px) 50vw, 100vw', section: section -%}
      </div>
      <div class="bp-banner__content">{%- render 'banner-content', section: section -%}</div>
    </div>
  {%- else -%}
    <div class="bp-banner__frame bp-banner__frame--{{ s.height }} bp-banner__frame--{{ s.position }}" style="--bp-overlay: {{ s.overlay | times: 0.01 }};">
      <div class="bp-banner__image">
        {%- if s.image_mobile != blank -%}
          <div class="bp-hide-desktop">{%- render 'section-image', image: s.image_mobile, sizes: '100vw', section: section -%}</div>
          <div class="bp-hide-mobile">{%- render 'section-image', image: s.image, sizes: '100vw', section: section -%}</div>
        {%- else -%}
          {%- render 'section-image', image: s.image, sizes: '100vw', section: section -%}
        {%- endif -%}
      </div>
      <div class="bp-page-width bp-page-width--{{ s.width }} bp-banner__over">
        <div class="bp-banner__content{% if s.show_box %} bp-banner__box{% endif %}">{%- render 'banner-content', section: section -%}</div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:sections.image_banner.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.common.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.image_banner.settings.image_mobile.label"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.common.settings.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Image banner"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.common.settings.subheading.label",
      "default": "Give shoppers a reason to look closer."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.image_banner.settings.button_label.label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.image_banner.settings.button_link.label"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:sections.image_banner.settings.button_label_2.label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:sections.image_banner.settings.button_link_2.label"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.image_banner.settings.layout.label",
      "default": "overlay",
      "options": [
        {
          "value": "overlay",
          "label": "t:sections.image_banner.settings.layout.options.overlay"
        },
        {
          "value": "split",
          "label": "t:sections.image_banner.settings.layout.options.split"
        }
      ]
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.image_banner.settings.height.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image_banner.settings.height.options.small"
        },
        {
          "value": "medium",
          "label": "t:sections.image_banner.settings.height.options.medium"
        },
        {
          "value": "large",
          "label": "t:sections.image_banner.settings.height.options.large"
        }
      ]
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:sections.image_banner.settings.position.label",
      "default": "bottom-left",
      "options": [
        {
          "value": "bottom-left",
          "label": "t:sections.image_banner.settings.position.options.bottom-left"
        },
        {
          "value": "center",
          "label": "t:sections.image_banner.settings.position.options.center"
        },
        {
          "value": "top-left",
          "label": "t:sections.image_banner.settings.position.options.top-left"
        }
      ],
      "visible_if": "{{ section.settings.layout == 'overlay' }}"
    },
    {
      "type": "checkbox",
      "id": "show_box",
      "label": "t:sections.image_banner.settings.show_box.label",
      "info": "t:sections.image_banner.settings.show_box.info",
      "default": true,
      "visible_if": "{{ section.settings.layout == 'overlay' }}"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.image_banner.settings.overlay.label",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0,
      "visible_if": "{{ section.settings.layout == 'overlay' }}"
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_banner.presets.image_banner.name"
    },
    {
      "name": "t:sections.image_banner.presets.image_banner_split.name",
      "settings": {
        "layout": "split",
        "padding_top": 80,
        "padding_bottom": 80
      }
    }
  ]
}
{% endschema %}
