<footer class="bp-footer" data-surface="{{ section.settings.surface_style }}">
  <div class="bp-page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="bp-footer__blocks">
        {%- for block in section.blocks -%}
          <div class="bp-footer__block bp-stack bp-stack--tight" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="bp-footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="bp-rte">{{ block.settings.text }}</div>
              {%- when 'newsletter' -%}
                {%- if block.settings.text != blank -%}
                  <div class="bp-rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- form 'customer', id: 'FooterNewsletter', class: 'bp-stack bp-stack--tight' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- if form.posted_successfully? -%}
                    <p class="bp-form-message" role="status">{{ 'newsletter.success' | t }}</p>
                  {%- elsif form.errors -%}
                    <div class="bp-form-message" role="alert">{{ form.errors | default_errors }}</div>
                  {%- endif -%}
                  <label class="bp-visually-hidden" for="NewsletterEmail-{{ block.id }}">{{ 'newsletter.email' | t }}</label>
                  <div class="bp-input-group">
                    <input
                      id="NewsletterEmail-{{ block.id }}"
                      class="bp-input"
                      type="email"
                      name="contact[email]"
                      autocomplete="email"
                      placeholder="{{ 'newsletter.email' | t }}"
                      required
                    >
                    <button type="submit" class="bp-button">{{ 'newsletter.submit' | t }}</button>
                  </div>
                {%- endform -%}
              {%- when 'social' -%}
                {%- render 'social-links' -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="bp-footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      <p class="bp-muted bp-small">
        {{ 'general.copyright' | t: year: current_year, shop: shop.name }}
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          {%- for policy in shop.policies -%}
            <span aria-hidden="true">&nbsp;·&nbsp;</span><a href="{{ policy.url }}">{{ policy.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="bp-payment-icons" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "bp-section-footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "surface",
      "options": [
        { "value": "default", "label": "t:sections.common.settings.surface_style.options.default" },
        { "value": "surface", "label": "t:sections.common.settings.surface_style.options.surface" },
        { "value": "inverse", "label": "t:sections.common.settings.surface_style.options.inverse" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:sections.footer.settings.show_policies.label",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.common.settings.heading.label", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "t:sections.footer.blocks.menu.settings.menu.label", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.common.settings.heading.label", "default": "About us" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label", "default": "<p>Tell customers what your brand stands for.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.common.settings.heading.label", "default": "Join the list" },
        { "type": "richtext", "id": "text", "label": "t:sections.footer.blocks.text.settings.text.label", "default": "<p>New launches and member offers. No spam.</p>" }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.common.settings.heading.label", "default": "Follow us" },
        { "type": "paragraph", "content": "t:sections.footer.blocks.social.settings.info" }
      ]
    }
  ]
}
{% endschema %}
