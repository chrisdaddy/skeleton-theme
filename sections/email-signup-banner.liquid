{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'banner', modifier: 'signup' %}>
  <div class="bp-banner__frame bp-banner__frame--{{ s.height }} bp-banner__frame--center" style="--bp-overlay: {{ s.overlay | times: 0.01 }};">
    <div class="bp-banner__image">
      {%- render 'section-image', image: s.image, sizes: '100vw', section: section -%}
    </div>
    <div class="bp-page-width bp-page-width--narrow bp-banner__over">
      <div class="bp-banner__content bp-banner__box bp-banner__box--center">
        {%- render 'section-heading', section: section -%}
        {%- render 'newsletter-form', id: section.id, button_label: s.button_label -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.email_signup_banner.name",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.common.settings.image.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Join the list"
    },
    {
      "type": "inline_richtext",
      "id": "subheading",
      "label": "t:sections.common.settings.subheading.label",
      "default": "Be first to hear about new launches."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.email_signup_banner.settings.button_label.label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.email_signup_banner.settings.height.label",
      "default": "medium",
      "options": [
        {
          "value": "small",
          "label": "t:sections.email_signup_banner.settings.height.options.small"
        },
        {
          "value": "medium",
          "label": "t:sections.email_signup_banner.settings.height.options.medium"
        },
        {
          "value": "large",
          "label": "t:sections.email_signup_banner.settings.height.options.large"
        }
      ]
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:sections.email_signup_banner.settings.overlay.label",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "full",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.email_signup_banner.presets.email_signup_banner.name"
    }
  ]
}
{% endschema %}
