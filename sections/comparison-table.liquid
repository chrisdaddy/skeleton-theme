{{ 'section-content.css' | asset_url | stylesheet_tag }}
{{ 'section-landing.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign columns = s.columns | plus: 0
  assign modifier = 'cols-' | append: columns
  assign label = s.heading | strip_html
  if label == blank
    assign label = 'sections.comparison_table.label' | t
  endif
-%}
<section {% render 'section-attributes', section: section, name: 'comparison', modifier: modifier %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    {%- render 'section-heading', section: section -%}
    <div class="bp-comparison__scroll{% if s.sticky_first %} bp-comparison--sticky{% endif %}" tabindex="0" role="group" aria-label="{{ label | escape }}">
      <table class="bp-comparison__table">
        <thead>
          <tr>
            <td></td>
            {%- for i in (1..columns) -%}
              {%- assign key = 'column_' | append: i -%}
              <th scope="col" {% if s.highlight == i %}class="bp-comparison__highlight"{% endif %}>{{ s[key] | escape }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.label | escape }}</th>
              {%- for i in (1..columns) -%}
                {%- assign key = 'cell_' | append: i -%}
                <td {% if s.highlight == i %}class="bp-comparison__highlight"{% endif %}>{%- render 'compare-cell', value: block.settings[key] -%}</td>
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</section>

{% schema %}
{
