{{ 'section-content.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign s = section.settings
  assign collection = s.collection
-%}
<section {% render 'section-attributes', section: section, name: 'collection', modifier: s.layout %}>
  <div class="bp-page-width bp-page-width--{{ s.width }}">
    <div class="bp-collection__head">
      {%- render 'section-heading', section: section, align: 'start' -%}
      {%- if s.view_all and collection != blank -%}
        <a class="bp-link-arrow" href="{{ collection.url }}">{{ 'sections.featured_collection.view_all' | t }}<span class="bp-visually-hidden"> {{ collection.title | escape }}</span></a>
      {%- endif -%}
    </div>
    {%- capture cards -%}
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: s.count -%}
          <li>{%- render 'product-card', product: product, show_rating: s.show_rating, show_badges: s.show_badges, quick_add: s.quick_add, sizes: '(min-width: 990px) 25vw, 50vw', section: section -%}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{%- render 'product-card-placeholder' -%}</li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if s.layout == 'carousel' -%}
      <bp-slider class="bp-slider" data-bp-module="{{ 'bp-slider.js' | asset_url }}" data-bp-load="visible" data-label-previous="{{ 'general.previous' | t }}" data-label-next="{{ 'general.next' | t }}">
        <ul class="bp-scroller" role="list" tabindex="0" aria-label="{{ s.heading | strip_html | escape }}" style="--bp-cols: {{ s.columns }}; --bp-slide-mobile: 46%;">{{ cards }}</ul>
      </bp-slider>
    {%- else -%}
      <ul class="bp-cols bp-product-grid" role="list" style="--bp-cols: {{ s.columns }}; --bp-cols-mobile: 2;">{{ cards }}</ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.common.settings.heading.label",
      "default": "Best sellers"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.common.settings.alignment.label",
      "default": "start",
      "options": [
        {
          "value": "start",
          "label": "t:sections.common.settings.alignment.options.start"
        },
        {
          "value": "center",
          "label": "t:sections.common.settings.alignment.options.center"
        }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "count",
      "label": "t:sections.featured_collection.settings.count.label",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.featured_collection.settings.columns.label",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.featured_collection.settings.layout.label",
      "default": "grid",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.featured_collection.settings.layout.options.grid"
        },
        {
          "value": "carousel",
          "label": "t:sections.featured_collection.settings.layout.options.carousel"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:sections.featured_collection.settings.show_rating.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "t:sections.featured_collection.settings.show_badges.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "quick_add",
      "label": "t:sections.featured_collection.settings.quick_add.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "t:sections.featured_collection.settings.view_all.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.common.settings.layout_header"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "t:sections.common.settings.surface_style.options.default"
        },
        {
          "value": "surface",
          "label": "t:sections.common.settings.surface_style.options.surface"
        },
        {
          "value": "accent",
          "label": "t:sections.common.settings.surface_style.options.accent"
        },
        {
          "value": "inverse",
          "label": "t:sections.common.settings.surface_style.options.inverse"
        }
      ]
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.common.settings.width.label",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:sections.common.settings.width.options.page"
        },
        {
          "value": "narrow",
          "label": "t:sections.common.settings.width.options.narrow"
        },
        {
          "value": "full",
          "label": "t:sections.common.settings.width.options.full"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:sections.common.settings.heading_tag.label",
      "default": "h2",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.common.settings.heading_tag.options.h2"
        },
        {
          "value": "h3",
          "label": "t:sections.common.settings.heading_tag.options.h3"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:sections.common.settings.padding_top.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:sections.common.settings.padding_bottom.label",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:sections.common.settings.hide_mobile.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:sections.common.settings.hide_desktop.label",
      "default": false
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "t:sections.common.settings.custom_class.label",
      "info": "t:sections.common.settings.custom_class.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.featured_collection.name"
    },
    {
      "name": "t:sections.featured_collection.presets.collection_carousel.name",
      "settings": {
        "layout": "carousel"
      }
    }
  ]
}
{% endschema %}
