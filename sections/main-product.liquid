{% comment %}
  Product page. The info column is the buy box: every part of it is a theme block
  (blocks/product-*.liquid), so merchants add, remove and reorder parts in the editor.

  One product form serves every block. The buy-buttons block owns the <form> (so
  dynamic checkout buttons sit inside it), and every other block points its inputs
  at it with the form attribute. The default id and quantity are printed here,
  before any block, so tier radios, the quantity block and plan radios later in
  the page take precedence (the last value of a repeated field wins).
{% endcomment %}
{{ 'section-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}
<div
  class="bp-section bp-page-width bp-product bp-product--media-{{ section.settings.media_size }}"
  style="--bp-media-fit: {{ section.settings.media_fit }};"
  data-surface="{{ section.settings.surface_style }}"
>
  <div class="bp-product__media">
    {%- render 'product-gallery', product: product, id_prefix: section.id -%}
  </div>

  <bp-product
    class="bp-product__info bp-buybox{% if section.settings.sticky_info %} bp-product__info--sticky{% endif %}"
    data-section-id="{{ section.id }}"
    data-product-url="{{ product.url }}"
    data-form-id="{{ form_id }}"
    data-cart-url="{{ routes.cart_url }}"
    data-error-message="{{ 'products.errors.generic' | t | escape }}"
    data-bp-module="{{ 'bp-product.js' | asset_url }}"
    data-bp-load="idle"
  >
    <input type="hidden" name="id" value="{{ current_variant.id }}" form="{{ form_id }}">
    <input type="hidden" name="quantity" value="1" form="{{ form_id }}">
    {% content_for 'blocks' %}
  </bp-product>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "t:sections.main_product.name",
  "class": "bp-section-product",
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "media_size",
      "label": "t:sections.main_product.settings.media_size.label",
      "default": "large",
      "options": [
        { "value": "medium", "label": "t:sections.main_product.settings.media_size.options.medium" },
        { "value": "large", "label": "t:sections.main_product.settings.media_size.options.large" }
      ]
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:sections.main_product.settings.media_fit.label",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "t:sections.main_product.settings.media_fit.options.cover" },
        { "value": "contain", "label": "t:sections.main_product.settings.media_fit.options.contain" }
      ]
    },
    {
      "type": "checkbox",
      "id": "sticky_info",
      "label": "t:sections.main_product.settings.sticky_info.label",
      "default": true
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:sections.common.settings.surface_style.label",
      "default": "default",
      "options": [
        { "value": "default", "label": "t:sections.common.settings.surface_style.options.default" },
        { "value": "surface", "label": "t:sections.common.settings.surface_style.options.surface" },
        { "value": "inverse", "label": "t:sections.common.settings.surface_style.options.inverse" }
      ]
    }
  ]
}
{% endschema %}
