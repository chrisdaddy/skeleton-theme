{{ 'section-content.css' | asset_url | stylesheet_tag }}
{{ 'section-landing.css' | asset_url | stylesheet_tag }}
{%- assign s = section.settings -%}
<section {% render 'section-attributes', section: section, name: 'article-body' %}>
  <div class="bp-page-width bp-page-width--{{ s.width }} bp-article-body__inner{% if s.drop_cap %} bp-article-body--dropcap{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 class="bp-h3" {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="bp-rte bp-article-body__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'image' -%}
          <figure class="bp-article-body__figure" {{ block.shopify_attributes }}>
            <div class="bp-media bp-ratio-{{ block.settings.ratio }}">{%- render 'section-image', image: block.settings.image, sizes: '(min-width: 990px) 760px, 100vw', section: section, width: 1600 -%}</div>
            {%- if block.settings.caption != blank -%}<figcaption class="bp-small bp-muted">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- when 'quote' -%}
          <figure class="bp-pullquote bp-pullquote--inline" {{ block.shopify_attributes }}>
            <blockquote class="bp-pullquote__quote">{{ block.settings.quote }}</blockquote>
            {%- if block.settings.attribution != blank -%}<figcaption class="bp-pullquote__by">{{ block.settings.attribution | escape }}</figcaption>{%- endif -%}
          </figure>
        {%- when 'product' -%}
          {%- assign item = block.settings.cta_product -%}
          <div class="bp-article-product" {{ block.shopify_attributes }}>
            <span class="bp-media bp-ratio-square bp-article-product__media">
              {%- if item.featured_media -%}
                {{ item.featured_media | image_url: width: 300 | image_tag: loading: 'lazy', class: 'bp-media__img', alt: '' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'bp-media__img' }}
              {%- endif -%}
            </span>
            <span class="bp-article-product__text">
              <span class="bp-article-product__title">{{ item.title | default: block.settings.cta_label | escape }}</span>
              {%- if item != blank -%}
                {%- assign price = item.price | money -%}
                <span class="bp-small bp-muted">{% if item.price_varies %}{{ 'products.price_from' | t: price: price }}{% else %}{{ price }}{% endif %}</span>
              {%- endif -%}
              {%- render 'cta-button', label: block.settings.cta_label, product: block.settings.cta_product, tier: block.settings.cta_tier, plan: block.settings.cta_plan, link: block.settings.cta_link, class: 'bp-button bp-button--small' -%}
            </span>
          </div>
        {%- when 'button' -%}
          <p class="bp-article-body__cta" {{ block.shopify_attributes }}>{%- render 'cta-button', label: block.settings.cta_label, product: block.settings.cta_product, tier: block.settings.cta_tier, plan: block.settings.cta_plan, link: block.settings.cta_link, class: 'bp-button' -%}</p>
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
