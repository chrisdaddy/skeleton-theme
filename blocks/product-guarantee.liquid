{% doc %}
  One-line guarantee, from the product's blueprint.guarantee metafield or the block text.
{% enddoc %}
{%- liquid
  assign product = closest.product
  assign guarantee = product.metafields.blueprint.guarantee.value
  assign text = guarantee.title.value | default: block.settings.text
-%}
{%- if text != blank -%}
  <p class="bp-inline-note bp-guarantee" {{ block.shopify_attributes }}>
    {%- render 'icon', name: block.settings.icon -%}
    <span>{{ text | escape }}</span>
  </p>
{%- endif -%}

