{% doc %}
  Three icon tiles under the button: guarantee, shipping, skip or cancel.
{% enddoc %}
<ul class="bp-trust-tiles" role="list" {{ block.shopify_attributes }}>
  {%- for i in (1..3) -%}
    {%- liquid
      assign icon_key = 'icon_' | append: i
      assign title_key = 'title_' | append: i
      assign text_key = 'text_' | append: i
    -%}
    {%- if block.settings[title_key] != blank -%}
      <li class="bp-trust-tile">
        {%- render 'icon', name: block.settings[icon_key] -%}
        <span class="bp-trust-tile__title">{{ block.settings[title_key] | escape }}</span>
        {%- if block.settings[text_key] != blank -%}
          <span class="bp-small bp-muted">{{ block.settings[text_key] | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

