{% doc %}
  One complementary product from the blueprint.upsell metafield, with its own add-to-cart form.
{% enddoc %}
{%- liquid
  assign product = closest.product
  assign upsell = product.metafields.blueprint.upsell.value
  assign upsell_variant = upsell.selected_or_first_available_variant
-%}
{%- if upsell != blank and upsell.available -%}
  <div class="bp-upsell" {{ block.shopify_attributes }}>
    <p class="bp-eyebrow">{{ block.settings.heading | escape }}</p>
    <div class="bp-upsell__row">
      {%- if upsell.featured_media -%}
        {{ upsell.featured_media | image_url: width: 120 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' , class: 'bp-upsell__image' }}
      {%- endif -%}
      <a class="bp-upsell__title" href="{{ upsell.url }}">
        {{- upsell.title | escape -}}
        <span class="bp-small bp-muted">{{ upsell_variant.price | money }}</span>
      </a>
      {%- form 'product', upsell, class: 'bp-upsell__form', data-type: 'add-to-cart-form' -%}
        <input type="hidden" name="id" value="{{ upsell_variant.id }}">
        <button type="submit" class="bp-button bp-button--secondary bp-button--small">
          {{- 'products.upsell.add' | t -}}
          <span class="bp-visually-hidden">{{ upsell.title | escape }}</span>
        </button>
      {%- endform -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:blocks.product_complementary.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.common.settings.heading.label",
      "default": "Goes well with"
    },
    {
      "type": "paragraph",
      "content": "t:blocks.product_complementary.settings.info"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.product_complementary.name",
      "category": "t:blocks.categories.buy_box"
    }
  ]
}
{% endschema %}
