{% doc %}
  A collapsible row (details/summary), from rich text or a page.
{% enddoc %}
{%- liquid
  assign content = block.settings.content
  if block.settings.page != blank
    assign content = block.settings.page.content
  endif
-%}
{%- if block.settings.heading != blank and content != blank -%}
  <details class="bp-accordion" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
    <summary class="bp-accordion__summary">
      {%- render 'icon', name: block.settings.icon -%}
      <span>{{ block.settings.heading | escape }}</span>
      {%- render 'icon', name: 'plus', class: 'bp-accordion__toggle' -%}
    </summary>
    <div class="bp-accordion__content bp-rte">{{ content }}</div>
  </details>
{%- endif -%}

