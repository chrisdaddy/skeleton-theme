{% layout none %}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ 'gift_card.title' | t: shop: shop.name }}</title>
    <meta name="robots" content="noindex">
    {%- render 'tokens' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent" class="bp-page-width bp-page-width--narrow bp-stack bp-center">
      <h1>{{ 'gift_card.title' | t: shop: shop.name }}</h1>
      {%- assign balance = gift_card.balance | money -%}
      <p class="bp-price">{{ balance }}</p>
      {%- if gift_card.expired -%}
        <p>{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
        <p class="bp-muted">{{ 'gift_card.expires_on' | t: date: expires_on }}</p>
      {%- endif -%}
      <p>
        <span class="bp-muted">{{ 'gift_card.code' | t }}</span>
        <strong>{{ gift_card.code | format_code }}</strong>
      </p>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}">{{ 'gift_card.add_to_apple_wallet' | t }}</a>
      {%- endif -%}
      <a class="bp-button" href="{{ shop.url }}">{{ 'gift_card.shop_link' | t }}</a>
    </main>
  </body>
</html>
