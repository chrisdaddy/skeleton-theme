{
  "name": "@blueprint/mcp",
  "version": "0.1.0",
  "description": "Blueprint Theme AI kit: an MCP server that edits draft copies of a Blueprint theme, never the live one.",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "bin": {
    "blueprint-mcp": "dist/index.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "prompts",
    "manifest.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync": "node scripts/sync.mjs",
    "build": "node scripts/sync.mjs && tsc -p tsconfig.json && node scripts/copy-prompts.mjs && node scripts/copy-updater.mjs && node scripts/manifest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "validate": "node scripts/validate-operations.mjs",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.mjs",
    "validate:manifest": "npx -y @anthropic-ai/mcpb@2.1.2 validate manifest.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "graphql": "16.9.0",
    "typescript": "5.9.3"
  }
}
